{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bifrost0x/varde/catalog/schema.json",
  "title": "Varde catalog entry",
  "description": "Editor support only. The authoritative validation is internal/catalog; see docs/catalog.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "homepage", "version", "advisories", "maintainers_of_entry", "verified"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" } },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match"],
        "properties": {
          "match": { "type": "string", "pattern": "^[^*?\\[:@]+$" },
          "flavor": { "enum": ["lsio"] },
          "note": { "type": "string" }
        }
      }
    },
    "oci_source": { "type": "array", "items": { "type": "string", "pattern": "^https://.*[^/]$" } },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manager", "name"],
        "properties": {
          "manager": { "enum": ["dpkg", "rpm", "apk", "firmware"], "description": "firmware: the operating system or firmware version an appliance reports through its own API" },
          "name": { "type": "string" },
          "versioning": { "enum": ["upstream", "distro"], "default": "distro" },
          "version_pattern": { "type": "string" },
          "source": { "type": "string", "description": "Source package name of the distribution's security data; default: name." }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit"],
        "properties": { "unit": { "type": "string" } }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme"],
      "properties": {
        "scheme": { "enum": ["semver", "calver"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "tag": { "type": "string", "pattern": "^\\^.*\\(\\?P<v>.*\\$$" },
              "normaliser": { "enum": ["lsio"] }
            },
            "oneOf": [{ "required": ["label"] }, { "required": ["tag"] }]
          }
        },
        "normalise": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "strip_prefix": { "type": "string", "maxLength": 32 } }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "http": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "expect"],
              "properties": {
                "path": { "type": "string", "pattern": "^/" },
                "json_pointer": { "type": "string" },
                "version_pattern": { "type": "string" },
                "expect": { "type": "object", "minProperties": 1, "maxProperties": 4, "additionalProperties": { "type": "string", "minLength": 1 } },
                "check_path": { "type": "string", "pattern": "^/" }
              }
            }
          }
        }
      }
    },
    "advisories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage"],
      "properties": {
        "coverage": { "enum": ["full", "partial", "limited"] },
        "github_repos": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$" } },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "ecosystem": { "type": "string" },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        },
        "osv_packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecosystem", "name"],
            "properties": {
              "ecosystem": { "enum": ["Go", "npm", "PyPI", "Packagist", "NuGet", "Maven", "crates.io", "RubyGems", "Hex", "Pub"] },
              "name": { "type": "string" }
            }
          }
        },
        "cpe": { "type": "array", "items": { "type": "string", "pattern": "^cpe:2\\.3:[aho]:" } },
        "notes": { "type": "string", "maxLength": 2048 }
      }
    },
    "exposure_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "typical": { "enum": ["public", "lan", "internal"] }
      }
    },
    "eol": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]{0,63}$", "description": "Product name on endoflife.date." },
    "maintainers_of_entry": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
